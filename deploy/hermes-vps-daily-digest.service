[Unit]
Description=JR Hermes VPS — Daily operational digest
After=network.target
ConditionPathExists=/opt/hermes-vps
# T0.2 (S17)
StartLimitIntervalSec=3600
StartLimitBurst=5

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/hermes-vps

# The digest script needs only FINDINGS_DB_URL + TELEGRAM_BOT_TOKEN/CHAT_ID, all
# in this file. The old optional EnvironmentFile=-/opt/hermes_v2/.env was dropped
# S13 (2026-09-05) with the hermes_v2 decommission — it supplied nothing used here.
EnvironmentFile=/root/.hermes_vps/.env

ExecStart=/opt/hermes-vps/.venv/bin/python3 /opt/hermes-vps/scripts/audit/hermes_vps_daily_digest.py

StandardOutput=journal
StandardError=journal
SyslogIdentifier=hermes-vps-daily-digest

# Don't restart oneshot services; errors are logged and can be checked via journalctl
Restart=no
