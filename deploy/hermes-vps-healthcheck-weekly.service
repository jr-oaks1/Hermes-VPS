[Unit]
Description=Hermes VPS Weekly Health Check (quick)
Documentation=https://github.com/jr-oaks1/Hermes-VPS
After=network-online.target postgresql.service hermes_v2.service
Wants=network-online.target
PartOf=hermes-vps-healthcheck-weekly.timer

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/hermes-vps
EnvironmentFile=/opt/hermes_v2/.env
EnvironmentFile=/root/.hermes_vps/.env
ExecStart=/opt/hermes-vps/.venv/bin/python3 /opt/hermes-vps/scripts/audit/hermes_vps_health_check.py --mode quick
StandardOutput=append:/opt/hermes-vps/logs/hermes_vps_healthcheck.log
StandardError=append:/opt/hermes-vps/logs/hermes_vps_healthcheck.log
SupplementaryGroups=postgres
PrivateTmp=true
NoNewPrivileges=true
TimeoutStartSec=90

[Install]
WantedBy=multi-user.target
