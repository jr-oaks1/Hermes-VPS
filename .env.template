# JR Hermes VPS — Environment Template
# Copy to /root/.hermes_vps/.env on server (mode 600, not git-tracked).
# Replace <placeholders> with real values on the host — NEVER commit real values
# (S07 was a plaintext-secret incident on this public repo).

# ── Databases ────────────────────────────────────────────────────────────────
# hermes_v2 DB — read-only, for replication + ingestion-freshness checks
DATABASE_URL=postgresql://<role>:<pw>@localhost/hermes_v2

# This project's own findings log (least-privilege). Written by the health check,
# guardrail, escalation check and scripts/log_finding.py. TimescaleDB hypertable
# since S17 (1-month chunks, compression after 90d, NO retention — T-LOG.3).
HERMES_VPS_LOG_DB_URL=postgresql://hermes_vps:<pw>@localhost/hermes_vps_log

# Unified GM findings DB (vps_orchestrator_findings) — read for the daily digest;
# written via /opt/jrvps-orchestrator/scripts/log_operational_finding.py. REQUIRED
# by hermes_vps_health_check.py (unified-DB mirror) and hermes_vps_daily_digest.py.
FINDINGS_DB_URL=postgresql://<reader>:<pw>@localhost/vps_orchestrator_findings

# Legacy (hermes_v2 era) — present on the host, not read by any script in THIS
# repo. Left documented so a future audit knows it is intentionally unused here.
#HERMES_LOG_DB_URL=

# ── Telegram — JR Hermes VPS infra bot (@JRHermesVPSBot) ─────────────────────
TELEGRAM_BOT_TOKEN=<bot_token>
TELEGRAM_CHAT_ID=360294128

# ── Cloud-review routine (RemoteTrigger API, optional) ───────────────────────
CLOUD_REVIEW_API_KEY=<required_for_RemoteTrigger_automation>

# ── ARCHIVED — Prometheus/Grafana were never the live stack (netdata is). ────
# See deploy/_archived/README.md. Kept here only so an old /root/.hermes_vps/.env
# with these lines is not flagged as unknown.
#PROMETHEUS_RETENTION_DAYS=30
#GRAFANA_ADMIN_PASSWORD=<unused>
#GRAFANA_DATASOURCES_UID=prometheus-default
