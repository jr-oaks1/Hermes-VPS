# JR Hermes VPS — Environment Template
# Copy to /root/.hermes_vps/.env on server (mode 600, not git-tracked)
# Replace placeholders with actual values before deployment

# Prometheus
PROMETHEUS_RETENTION_DAYS=30

# Grafana
GRAFANA_ADMIN_PASSWORD=<set_manually_on_server>
GRAFANA_DATASOURCES_UID=prometheus-default

# Health Check — Databases
DATABASE_URL=postgresql://hermes:hermes@localhost/hermes
HERMES_LOG_DB_URL=postgresql://hermes_v2:hermes_v2@localhost/findings_log
HERMES_VPS_LOG_DB_URL=postgresql://hermes_vps:hermes_vps@localhost/hermes_vps_log

# Telegram Bot — Hermes VPS infrastructure alerts
TELEGRAM_BOT_TOKEN=<existing_bot_token_or_new>
TELEGRAM_CHAT_ID=360294128

# Cloud-Review Routine (RemoteTrigger API, if using remote scheduling)
CLOUD_REVIEW_API_KEY=<required_for_RemoteTrigger_automation>
